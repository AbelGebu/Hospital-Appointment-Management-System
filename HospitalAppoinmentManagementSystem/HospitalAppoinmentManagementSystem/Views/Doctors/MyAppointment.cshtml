@model IEnumerable<HospitalAppoinmentManagementSystem.Models.Appointment>

<h2>My Schedule & Appointments</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Patient Name</th>
            <th>Patient Email</th>
            <th>Slot Time</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Patient?.FullName</td>
                <td>@item.Patient?.Email</td>
                <td>@item.Timeslot?.SlotTime.ToString("g")</td>
                <td>
                    <span class="badge @(item.Status == "Approved" ? "bg-success" : item.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (item.Status == "Pending")
                    {
                        <form asp-action="Approve" asp-route-id="@item.AppointmentId" method="post">
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>