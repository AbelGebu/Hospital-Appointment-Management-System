@model IEnumerable<HospitalAppoinmentManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Schedule & Appointments";
}

<style>
    :root {
        --titanium-white: #ffffff;
        --titanium-bg: #f8f9fa;
        --emerald-green: #059669;
        --emerald-hover: #047857;
        --emerald-light: #ecfdf5;
        --text-dark: #1f2937;
        --border-color: #e5e7eb;
    }

    body {
        background-color: var(--titanium-white);
        color: var(--text-dark);
    }

    .text-emerald {
        color: var(--emerald-green) !important;
    }

    .bg-emerald-header {
        background-color: var(--emerald-green) !important;
        color: white !important;
    }

    .btn-emerald {
        background-color: var(--emerald-green) !important;
        color: white !important;
        border: none;
        transition: background-color 0.2s ease;
    }

        .btn-emerald:hover {
            background-color: var(--emerald-hover) !important;
            color: white !important;
        }

    .btn-outline-emerald {
        color: var(--emerald-green) !important;
        border-color: var(--emerald-green) !important;
        background-color: transparent;
        transition: all 0.2s ease;
    }

        .btn-outline-emerald:hover {
            background-color: var(--emerald-green) !important;
            color: white !important;
        }

    .page-title {
        font-weight: 600;
        letter-spacing: -0.5px;
        position: relative;
        padding-bottom: 10px;
    }

        .page-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            height: 3px;
            width: 50px;
            background-color: var(--emerald-green);
            border-radius: 2px;
        }

    .custom-table {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        background-color: var(--titanium-white);
    }
</style>

<div class="container my-4 mb-5">
    <h2 class="page-title text-emerald mb-4">My Schedule & Appointments</h2>

    <div class="table-responsive custom-table">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-emerald-header">
                <tr>
                    <th class="py-3 ps-4">Patient Name</th>
                    <th class="py-3">Patient Email</th>
                    <th class="py-3">Slot Time</th>
                    <th class="py-3">Status</th>
                    <th class="py-3 pe-4 text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x me-2"></i>No appointments scheduled at the moment.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="py-3 ps-4 fw-semibold text-dark">@item.Patient?.FullName</td>
                        <td class="py-3 text-muted">@item.Patient?.Email</td>
                        <td class="py-3">
                            <span class="text-dark">@item.Timeslot?.SlotTime.ToString("g")</span>
                        </td>
                        <td class="py-3">
                            <span class="badge rounded-pill @(item.Status == "Approved" ? "bg-success" : item.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                @item.Status
                            </span>
                        </td>
                        <td class="py-3 pe-4 text-end">
                            @if (item.Status == "Pending")
                            {
                                <form asp-action="Approve" asp-route-id="@item.AppointmentId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-emerald btn-sm px-3 shadow-sm">
                                        Approve
                                    </button>
                                </form>
                            }
                            else if (item.Status == "Approved")
                            {
                                <a asp-action="Prescribe" asp-route-appointmentId="@item.AppointmentId" class="btn btn-sm btn-outline-emerald px-3 shadow-sm">
                                    Write Prescription
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>