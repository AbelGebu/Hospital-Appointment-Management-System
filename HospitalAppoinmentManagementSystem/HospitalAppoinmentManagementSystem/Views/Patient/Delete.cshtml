@model HospitalAppoinmentManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<div class="mb-4">
    <h1 class="h3 mb-0">Delete Patient</h1>
    <p class="text-muted mb-0">Please confirm you want to delete this patient record.</p>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="alert alert-danger" role="alert">
            <strong>Warning:</strong> This action cannot be undone.
            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <span>
                    This patient has <strong>@Model.Appointments.Count</strong> associated appointment(s)
                    which may also be affected.
                </span>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Patient ID</dt>
                    <dd class="col-sm-8">@Model.PatientId</dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="PatientId" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Delete Patient</button>
            </div>
        </form>
    </div>
</div>
