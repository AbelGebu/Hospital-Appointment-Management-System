@model IEnumerable<HospitalAppoinmentManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">My Appointments</h1>
        <p class="text-muted mb-0">Track the status of your booked appointments.</p>
    </div>
    <a asp-action="Doctors" class="btn btn-primary">Book New Appointment</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You don't have any appointments yet. <a asp-action="Doctors" class="alert-link">Find a doctor</a> to book one.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Doctor</th>
                        <th scope="col">Specialty</th>
                        <th scope="col">Date &amp; Time</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model.OrderByDescending(a => a.Timeslot!.SlotTime))
                    {
                        var badgeClass = appointment.Status switch
                        {
                            "Approved" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };
                        var canCancel = appointment.Status != "Cancelled"
                            && appointment.Timeslot != null
                            && appointment.Timeslot.SlotTime > DateTime.Now;

                        <tr>
                            <td>Dr. @appointment.Timeslot?.Doctor?.FullName</td>
                            <td>@appointment.Timeslot?.Doctor?.Specialty</td>
                            <td>@(appointment.Timeslot?.SlotTime.ToString("dddd, dd MMM yyyy - hh:mm tt") ?? "—")</td>
                            <td><span class="badge @badgeClass">@appointment.Status</span></td>
                            <td class="text-end">
                                @if (canCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post"
                                          class="d-inline" onsubmit="return confirm('Cancel this appointment?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
