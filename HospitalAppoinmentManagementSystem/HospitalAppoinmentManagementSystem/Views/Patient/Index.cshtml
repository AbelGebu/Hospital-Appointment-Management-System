@model IEnumerable<HospitalAppoinmentManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Patients</h1>
        <p class="text-muted mb-0">Manage registered patients and their appointment records.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        Add Patient
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No patients have been registered yet. Click <strong>Add Patient</strong> to create the first record.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Patient ID</th>
                        <th scope="col">Full Name</th>
                        <th scope="col">Phone Number</th>
                        <th scope="col" class="text-center">Appointments</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.FullName</td>
                            <td>@patient.PhoneNumber</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">
                                    @(patient.Appointments?.Count ?? 0)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Patient actions">
                                    <a asp-action="Details" asp-route-id="@patient.PatientId"
                                       class="btn btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@patient.PatientId"
                                       class="btn btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@patient.PatientId"
                                       class="btn btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
