@model HospitalAppoinmentManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Patient Details</h1>
        <p class="text-muted mb-0">Full record for patient #@Model.PatientId.</p>
    </div>
    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model.PatientId" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Patient ID</dt>
            <dd class="col-sm-9">@Model.PatientId</dd>

            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Phone Number</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Appointment History</h2>
    </div>
    @if (Model.Appointments == null || !Model.Appointments.Any())
    {
        <div class="card-body">
            <p class="text-muted mb-0">This patient has no appointments on record.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Doctor</th>
                        <th scope="col">Reason</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@(appointment.Doctor?.DoctorName ?? "—")</td>
                            <td>@appointment.Reason</td>
                            <td>
                                @{
                                    var badgeClass = appointment.Status switch
                                    {
                                        "Completed" => "bg-success",
                                        "Cancelled" => "bg-danger",
                                        "Confirmed" => "bg-primary",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badgeClass">@appointment.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
